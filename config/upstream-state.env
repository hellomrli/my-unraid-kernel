# State of the last successfully built release combination.
# The watch-upstream workflow compares its detection results against these
# values; the build workflow advances them after a successful auto build.
#
# Current values mirror the newest published build (7.4.0-beta.1 with the
# official 6.18.44-Unraid kernel and strongtz i915 SR-IOV 2026.08.12.1), so
# the first automatic check is a no-op unless an upstream source moved.
LAST_UNRAID_VERSION=7.4.0-beta.1
LAST_KERNEL_RELEASE=6.18.44-Unraid
LAST_I915_SRIOV_REF=2026.08.12.1

# GCC toolchain floor. Builds use max(MIN_GCC_VERSION, official kernel GCC):
# the official Unraid kernel package is the reference for the compiler, and
# 15.3.0 is the default until the official builds move to a newer GCC.
MIN_GCC_VERSION=15.3.0
