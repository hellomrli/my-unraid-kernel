# State of the last successfully built release combination.
# The watch-upstream workflow compares its detection results against
# these values; the build workflow advances them after a successful
# auto build.
LAST_UNRAID_VERSION=7.4.0-beta.2
LAST_KERNEL_RELEASE=6.18.47-Unraid

# GCC toolchain floor. Builds use max(MIN_GCC_VERSION, official kernel GCC).
MIN_GCC_VERSION=15.3.0
