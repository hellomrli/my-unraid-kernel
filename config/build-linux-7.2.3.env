# 实验分支：vanilla Linux 7.2.3（kernel.org 主线）+ Unraid 7.4.0-beta.2 基座。
# 与常规构建的区别：
#   1. 内核源码来自 kernel.org，不含 ich777 的预编译产物，
#      REBUILD_KERNEL 必须为 true，完整重编 bzImage 与全部模块；
#   2. 以 beta.2 对应的 6.18.47-Unraid 源码包为“种子”：取其 .config（含
#      CONFIG_LOCALVERSION="-Unraid"，使内核版本号为 7.2.3-Unraid），
#      并把 Lime Technology 的阵列驱动 drivers/md/{md_unraid.c,
#      md_unraid.h,unraid.c} 移植进 vanilla 树（见 10-prepare-kernel.sh）；
#   3. OpenZFS 2.4.4 支持 Linux 7.2，与 beta.2 用户空间版本一致。
#   4. patches/linux-7.2.3-hardware.series 保留 beta.2 的 ACS override、
#      NVMe、mvsas、Mozart、Thunderbolt 默认设置及 EDID 日志降噪。
#      旧 raid6_choose_xor 补丁的取舍见 beta.2 测试记录。
UNRAID_VERSION=7.4.0-beta.2
TARGET_KERNEL_VERSION=7.2.3
KERNEL_RELEASE=7.2.3-Unraid
JOBS=all

CC=gcc
HOSTCC=gcc
CXX=g++
HOSTCXX=g++
# 与 beta.2 官方内核使用的 GCC 版本一致；本地可通过 PATH 选择工具链。
EXPECTED_CC_VERSION=15.3.0

# kernel.org 主线源码
KERNEL_ARCHIVE_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.3.tar.xz
KERNEL_ARCHIVE_SHA256=8ba259e8e7b13ec6ef0941c8a39ad90b24bd4a4d6c0010ba6bafb794550ecd03

# 种子源码包（仅用于提取 .config 与 unraid md 驱动源文件）
SEED_KERNEL_RELEASE=6.18.47-Unraid
SEED_KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.47-Unraid/linux-6.18.47-Unraid.tar.xz
SEED_KERNEL_ARCHIVE_SHA256=72822aea43a7d6dab3ae7a8489481a583504896927c1ce7117df8ab1b46d173f

# 官方 Unraid USB 镜像作为包基座
UNRAID_ZIP_URL=https://next.dl.unraid.net/7.4.0-beta.2/0ecadeb5b9c44b3df60368a323d2c91c5c3c1f54321b4a8abd25587e9583207e/unRAIDServer-7.4.0-beta.2-x86_64.zip
# 从官方 HTTPS ZIP 计算；包内 bz* / memtest 的官方 SHA256 侧车均已核验。
UNRAID_ZIP_SHA256=b214c9583bff4bdb3847a7ca1cc43fc7b31c8e6a2995a8c2727185ccccb9f9fc

# 2.4.4 正式版已支持 Linux 4.18–7.2，无需使用 2.4.99 开发快照。
ZFS_VERSION=2.4.4
ZFS_TARBALL_URL=https://github.com/openzfs/zfs/releases/download/zfs-2.4.4/zfs-2.4.4.tar.gz
ZFS_TARBALL_SHA256=2a3c70d55a37cc71618a95a60e81ad66530201eb118d37741dc92efcf848c8b1

FORCE_PREPARE=false
REBUILD_KERNEL=true
CLEAN_KERNEL_BUILD=true
CLEAN_ZFS_BUILD=true
