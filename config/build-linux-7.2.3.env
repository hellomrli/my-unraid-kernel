# 实验分支：vanilla Linux 7.2.3（kernel.org 主线）+ Unraid 7.4.0-beta.1 基座。
# 与常规构建的区别：
#   1. 内核源码来自 kernel.org，不含 ich777 的预编译产物，
#      REBUILD_KERNEL 必须为 true，完整重编 bzImage 与全部模块；
#   2. 以 6.18.44-Unraid 源码包为“种子”：取其 .config（含
#      CONFIG_LOCALVERSION="-Unraid"，使内核版本号为 7.2.3-Unraid），
#      并把 Lime Technology 的阵列驱动 drivers/md/{md_unraid.c,
#      md_unraid.h,unraid.c} 移植进 vanilla 树（见 10-prepare-kernel.sh）；
#   3. OpenZFS 2.4.3 能否在 7.2.3 上编译是本实验的未知项之一。
# 注意：未随内核带入的其他 Lime Technology 补丁不在本次移植范围内。
UNRAID_VERSION=7.4.0-beta.1
TARGET_KERNEL_VERSION=7.2.3
KERNEL_RELEASE=7.2.3-Unraid
JOBS=all

CC=gcc
HOSTCC=gcc
CXX=g++
HOSTCXX=g++
EXPECTED_CC_VERSION=

# kernel.org 主线源码
KERNEL_ARCHIVE_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.2.3.tar.xz
KERNEL_ARCHIVE_SHA256=8ba259e8e7b13ec6ef0941c8a39ad90b24bd4a4d6c0010ba6bafb794550ecd03

# 种子源码包（仅用于提取 .config 与 unraid md 驱动源文件）
SEED_KERNEL_RELEASE=6.18.44-Unraid
SEED_KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.44-Unraid/linux-6.18.44-Unraid.tar.xz
SEED_KERNEL_ARCHIVE_SHA256=618df8d001e9f98b95306eb2eac4cb776d0bf4b98061f0f4cedbc10c1468858d

# 官方 Unraid USB 镜像作为包基座
UNRAID_ZIP_URL=https://next.dl.unraid.net/7.4.0-beta.1/aeed47b86d6c255f21e9582d068777c975cc257c096a8ea05642726e67535ca3/unRAIDServer-7.4.0-beta.1-x86_64.zip
UNRAID_ZIP_SHA256=f0acb2cc6f15ab5d1250c776c3fd439e1eac723dc7de3e49c5a2be094e06b86d

# ZFS 2.4.3 的内核兼容上限是 7.0（configure 直接拒绝 7.2.3），改用
# OpenZFS master 快照（META: Linux-Maximum 7.2）。锁定 2026-09-01 的
# master 提交以保证可重现；模块版本串为 2.4.99-1，与 50-verify 的
# "$ZFS_VERSION-1" 检查一致。参考 thor2002ro 同款做法（跟踪 master）。
ZFS_VERSION=2.4.99
ZFS_TARBALL_URL=https://codeload.github.com/openzfs/zfs/tar.gz/013d73a9bfcbcffbbc3010a912fe3d6c501a9634
ZFS_TARBALL_SHA256=c7277d147935fa17a1ef398e74ae04a4cfcb62202d27c5df02a7160e9e213d9a

FORCE_PREPARE=false
REBUILD_KERNEL=true
CLEAN_KERNEL_BUILD=true
CLEAN_ZFS_BUILD=true
