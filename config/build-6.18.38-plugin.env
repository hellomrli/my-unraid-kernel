# Unraid 7.3.2 / 官方 Linux 6.18.38 纯插件构建。
# 内核源码树和 Module.symvers 来自 ich777/unraid_kernel，
# 有意不重建；本包面向已安装 6.18.38-Unraid 的系统。
UNRAID_VERSION=7.3.2
TARGET_KERNEL_VERSION=6.18.38
KERNEL_RELEASE=6.18.38-Unraid
JOBS=all
PLUGIN_ONLY=true

KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.38-Unraid/linux-6.18.38-Unraid.tar.xz
KERNEL_ARCHIVE_SHA256=b336c66bf1d7ee2cedba88e8be2124b2256c94476b1d1c944518ce8d6bcf37da

# 这些值在纯插件流程中不会用到，但能保证源码下载的确定性，
# 并与 scripts/01-fetch-sources.sh 保持兼容。
UNRAID_ZIP_URL=https://releases.unraid.net/dl/stable/7.3.2/cce9ffc6d2278430ab0029c5b4d66135fa2e9dd2728fc3365cdffa485ebcd713/unRAIDServer-7.3.2-x86_64.zip
UNRAID_ZIP_SHA256=9ecf63726f69b8b11706e87bbcbfbea8ac8863bfed0867a1f9dcc272dee21420

I915_SRIOV_REPO=https://github.com/strongtz/i915-sriov-dkms.git
I915_SRIOV_REF=2026.08.08
I915_SRIOV_COMMIT=1a2f7cfe0ceadea9a9f8b2485ed3d0bff0cf1b24
I915_MAX_VFS=7

# 外部模块使用指定的 GCC 15.3.0 工具链。
CC=/home/lain/.local/gcc-15.3.0/bin/gcc
HOSTCC=/home/lain/.local/gcc-15.3.0/bin/gcc
CXX=/home/lain/.local/gcc-15.3.0/bin/g++
HOSTCXX=/home/lain/.local/gcc-15.3.0/bin/g++
EXPECTED_CC_VERSION=15.3.0

ZFS_VERSION=2.4.3
ZFS_TARBALL_URL=https://github.com/openzfs/zfs/releases/download/zfs-2.4.3/zfs-2.4.3.tar.gz
ZFS_TARBALL_SHA256=1f08f2d154f5189b5f1382848a32667b3d34066145b474c49cd3d41a5fba59a7

FORCE_PREPARE=false
REBUILD_KERNEL=false
CLEAN_KERNEL_BUILD=false
CLEAN_ZFS_BUILD=false
