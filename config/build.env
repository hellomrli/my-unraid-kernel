# Copy this file to config/build.env and edit values when needed.

# Target platform.
UNRAID_VERSION=7.3.1
UNRAID_BASE_KERNEL=6.18.33-Unraid
TARGET_KERNEL_VERSION=7.1.1
LOCALVERSION=-Unraid

# Build parallelism. Use "all" or an integer.
JOBS=all

# Kernel source and Unraid baseline config source.
KERNEL_TARBALL_URL=https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-7.1.1.tar.xz
BASE_KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.33-Unraid/linux-6.18.33-Unraid.tar.xz

# Fallback config from thor2002ro/unraid_kernel if the ich777 archive is not
# downloaded or does not contain a .config.
THOR_REPO_DIR=thor2002ro-unraid_kernel
THOR_CONFIG_FILE=unraid_7.1.4_conf_regen-7.1-vendor-gcc

# SR-IOV driver source. The upstream project currently supports 6.17.x-7.0.x;
# using this branch on 7.1.1 is an experimental forward-port build.
I915_SRIOV_REPO=https://github.com/strongtz/i915-sriov-dkms.git
I915_SRIOV_BRANCH=kernel-v7.0
I915_MAX_VFS=7

# Set to true to rebuild an existing prepared tree from scratch.
FORCE_PREPARE=false
