# Unraid 7.3.2 / Linux 6.18.43 full build using GCC 16.2.0.
# This configuration is for local compatibility testing of the complete
# kernel, i915 SR-IOV modules, OpenZFS modules, and Unraid system package.
UNRAID_VERSION=7.3.2
TARGET_KERNEL_VERSION=6.18.43
KERNEL_RELEASE=6.18.43-Unraid
JOBS=all
PLUGIN_ONLY=false

CC=/home/lain/.local/gcc-16.2.0/bin/gcc
HOSTCC=/home/lain/.local/gcc-16.2.0/bin/gcc
# GCC 16.2.0 is intentionally built C-only. Kernel and OpenZFS modules are
# C; these host C++ variables are only required by the shared environment
# checks and use the existing GCC 15.3 C++ frontend.
CXX=/home/lain/.local/gcc-15.3.0/bin/g++
HOSTCXX=/home/lain/.local/gcc-15.3.0/bin/g++
EXPECTED_CC_VERSION=16.2.0

KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.43-Unraid/linux-6.18.43-Unraid.tar.xz
KERNEL_ARCHIVE_SHA256=888d5f8eb9643b9e425eafe25f015933813013487382aef21e3b60caf7e2bcfd

UNRAID_ZIP_URL=https://releases.unraid.net/dl/stable/7.3.2/cce9ffc6d2278430ab0029c5b4d66135fa2e9dd2728fc3365cdffa485ebcd713/unRAIDServer-7.3.2-x86_64.zip
UNRAID_ZIP_SHA256=9ecf63726f69b8b11706e87bbcbfbea8ac8863bfed0867a1f9dcc272dee21420

I915_SRIOV_REPO=https://github.com/strongtz/i915-sriov-dkms.git
I915_SRIOV_REF=2026.08.08
I915_SRIOV_COMMIT=1a2f7cfe0ceadea9a9f8b2485ed3d0bff0cf1b24
I915_MAX_VFS=7
PACKAGE_BUILD=2

ZFS_VERSION=2.4.3
ZFS_TARBALL_URL=https://github.com/openzfs/zfs/releases/download/zfs-2.4.3/zfs-2.4.3.tar.gz
ZFS_TARBALL_SHA256=1f08f2d154f5189b5f1382848a32667b3d34066145b474c49cd3d41a5fba59a7

FORCE_PREPARE=false
REBUILD_KERNEL=true
CLEAN_KERNEL_BUILD=true
CLEAN_ZFS_BUILD=true
