# Unraid 7.4.0-beta.1 / Linux 6.18.44 SR-IOV 集成构建。
UNRAID_VERSION=7.4.0-beta.1
TARGET_KERNEL_VERSION=6.18.44
KERNEL_RELEASE=6.18.44-Unraid
JOBS=all
PLUGIN_ONLY=false

# 注入的 SR-IOV 模块使用 GCC 16.2.0 编译。本机 GCC 16 只编译了 C，
# 因此共享的环境检查保留 GCC 15.3 的 C++ 前端。
CC=/home/lain/.local/gcc-16.2.0/bin/gcc
HOSTCC=/home/lain/.local/gcc-16.2.0/bin/gcc
CXX=/home/lain/.local/gcc-15.3.0/bin/g++
HOSTCXX=/home/lain/.local/gcc-15.3.0/bin/g++
EXPECTED_CC_VERSION=16.2.0

KERNEL_ARCHIVE_URL=https://github.com/ich777/unraid_kernel/releases/download/6.18.44-Unraid/linux-6.18.44-Unraid.tar.xz
KERNEL_ARCHIVE_SHA256=618df8d001e9f98b95306eb2eac4cb776d0bf4b98061f0f4cedbc10c1468858d

# 除合并进 bzroot 的 SR-IOV 模块外，测试版镜像逐字节保留；
# 包自带的 OpenZFS 模块保持不变。
UNRAID_ZIP_URL=https://next.dl.unraid.net/7.4.0-beta.1/aeed47b86d6c255f21e9582d068777c975cc257c096a8ea05642726e67535ca3/unRAIDServer-7.4.0-beta.1-x86_64.zip
UNRAID_ZIP_SHA256=f0acb2cc6f15ab5d1250c776c3fd439e1eac723dc7de3e49c5a2be094e06b86d
USE_STOCK_BZIMAGE=true
MERGE_STOCK_MODULES=true
USE_STOCK_ZFS=true

I915_SRIOV_REPO=https://github.com/strongtz/i915-sriov-dkms.git
I915_SRIOV_REF=2026.08.12.1
I915_SRIOV_COMMIT=d52b7023ce6eefc8c7128cdc7ea931a056703c1c
I915_MAX_VFS=7
PACKAGE_BUILD=2

ZFS_VERSION=2.4.3
ZFS_TARBALL_URL=https://github.com/openzfs/zfs/releases/download/zfs-2.4.3/zfs-2.4.3.tar.gz
ZFS_TARBALL_SHA256=1f08f2d154f5189b5f1382848a32667b3d34066145b474c49cd3d41a5fba59a7

FORCE_PREPARE=false
REBUILD_KERNEL=false
CLEAN_KERNEL_BUILD=false
CLEAN_ZFS_BUILD=false
