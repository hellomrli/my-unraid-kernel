Subject: [PATCH] scsi: mvsas: recognize HighPoint RocketRAID 2782

Forward-port drivers_scsi_mvsas_rr_2782.patch from Unraid 7.4.0-beta.2
(src/linux-6.18.47-Unraid) to Linux 7.2.3.

--- a/drivers/scsi/mvsas/mv_init.c
+++ b/drivers/scsi/mvsas/mv_init.c
@@ -636,6 +636,7 @@
 	{ PCI_VDEVICE(TTI, 0x2740), chip_9480 },
 	{ PCI_VDEVICE(TTI, 0x2744), chip_9480 },
 	{ PCI_VDEVICE(TTI, 0x2760), chip_9480 },
+	{ PCI_VDEVICE(TTI, 0x2782), chip_9480 },
 	{
 		.vendor		= PCI_VENDOR_ID_MARVELL_EXT,
 		.device		= 0x9480,
